<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app_pastel">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart POS Terminal Kasir"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Simulasi Transaksi Pembayaran Berketahanan Tinggi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Input Barcode -->
            <EditText
                android:id="@+id/etBarcode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_pastel"
                android:hint="Pindai / Masukkan Barcode (Cth: 8991201)"
                android:paddingHorizontal="14dp"
                android:textSize="14sp" />

            <!-- Card Pilihan Simulasi Error -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode Simulasi Skenario:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgSimulation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:id="@+id/rbSuccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Simulasi Normal (Berhasil)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbBarcodeError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Error 404 (Barcode Tidak Ada)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbNetworkTimeout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Error Jaringan (Payment Timeout)"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbLimitExceeded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Simulasi Limit > Rp 10 Juta (Tugas 2)"
                            android:textSize="13sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcessPayment"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="Proses Pembayaran Transaksi"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pastel_teal"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

            <ProgressBar
                android:id="@+id/pbPosLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- Card Hasil Transaksi Mint Pastel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPosResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvPosStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pastel_mint"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="TRANSAKSI BERHASIL"
                        android:textColor="@color/pastel_mint_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPosDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Detail transaksi..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>